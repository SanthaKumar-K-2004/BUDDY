{
  "name": "@buddy/filter-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Quarantined build-time filter ingestion and Declarative Net Request (DNR) compilation pipeline",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "compile": "tsx src/cli/build.ts",
    "update": "tsx src/cli/update.ts",
    "validate": "tsx src/cli/validate.ts"
  },
  "dependencies": {
    "@adguard/agtree": "^4.2.1"
  },
  "devDependencies": {
    "@adguard/dnr-converter": "^1.1.2",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
