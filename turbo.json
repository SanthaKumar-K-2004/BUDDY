{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"]
    },
    "build:chrome": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"]
    },
    "build:firefox": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"]
    },
    "build:zip": {
      "dependsOn": ["build"],
      "outputs": [".output/*.zip"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
